# ── Kommo CRM ──────────────────────────────────────────────────────────────────
# Seu subdomínio: https://SEU_SUBDOMINIO.kommo.com
KOMMO_SUBDOMAIN=clinicaqara
# Token de longa duração gerado em Kommo > Integrações > API
KOMMO_API_TOKEN=your_long_lived_token_here

# ── Provedor de IA ─────────────────────────────────────────────────────────────
# "openai" ou "anthropic"
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Segurança ──────────────────────────────────────────────────────────────────
# Segredo do webhook (configure o mesmo valor em Kommo > Webhooks > secret)
WEBHOOK_SECRET=

# Chave para o endpoint POST /send (inspirado open-wa Easy API)
API_KEY=troque_por_chave_secreta

# ── Servidor ───────────────────────────────────────────────────────────────────
PORT=8000

# ── Conversação ────────────────────────────────────────────────────────────────
MAX_HISTORY_TURNS=20
DB_PATH=conversations.db
