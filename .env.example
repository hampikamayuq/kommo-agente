# ── Kommo CRM ──────────────────────────────────────────────────────────────────
# Seu subdomínio: https://SEU_SUBDOMINIO.kommo.com
KOMMO_SUBDOMAIN=clinicaqara
# Token de longa duração gerado em Kommo > Integrações > API
KOMMO_API_TOKEN=your_long_lived_token_here
# ID do usuário SalesBot (Kommo > Configurações > Usuários)
KOMMO_BOT_USER_ID=11783975
# Mapeamento de nome de etapa (como o modelo retorna) para status_id numérico do Kommo.
# Obtenha os IDs em: Kommo > Configurações > Pipelines > inspecionar URL ou via API GET /api/v4/leads/pipelines
# Exemplo: KOMMO_STAGE_MAP={"Aguardando Horários": 12345678, "Consulta Confirmada": 23456789}
KOMMO_STAGE_MAP={}

# ── Provedor de IA ─────────────────────────────────────────────────────────────
# "openai" ou "anthropic"
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Segurança ──────────────────────────────────────────────────────────────────
# Segredo do webhook (configure o mesmo valor em Kommo > Webhooks > secret)
WEBHOOK_SECRET=

# Chave para o endpoint POST /send (inspirado open-wa Easy API)
API_KEY=troque_por_chave_secreta

# ── Servidor ───────────────────────────────────────────────────────────────────
PORT=8000

# ── Conversação ────────────────────────────────────────────────────────────────
MAX_HISTORY_TURNS=20
DB_PATH=conversations.db

# ── Timeouts da máquina de estados ────────────────────────────────────────────
# Horas para retomada automática após intervenção humana
HUMAN_TIMEOUT_HOURS=4
# Minutos para retomada automática após o bot de agendamento parar de responder
# 3 minutos: agente assume logo após o SalesBot terminar o fluxo
BOT_TIMEOUT_MINUTES=3
